{
  "name": "learning-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "serve": "pnpm --dir apps/web serve",
    "build": "pnpm --dir apps/web build",
    "preview": "pnpm --dir apps/web preview",
    "typecheck": "pnpm --dir apps/web typecheck",
    "check:watch": "pnpm --dir apps/web check:watch",
    "test": "pnpm --dir apps/web test",
    "test:unit": "pnpm --dir apps/web test:unit",
    "check": "pnpm --dir apps/web check",
    "verify": "pnpm --dir apps/web verify",
    "lint": "pnpm --dir apps/web lint && pnpm --dir apps/pack-cli lint",
    "lint:fix": "pnpm --dir apps/web lint:fix && pnpm --dir apps/pack-cli lint:fix",
    "validate": "pnpm lint && pnpm fmt:check",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "verify:all": "pnpm fmt && pnpm verify && pnpm --dir apps/pack-cli verify && pnpm fmt:check",
    "pack:build": "tsx apps/pack-cli/src/index.ts build",
    "pack:verify": "tsx apps/pack-cli/src/index.ts verify"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
