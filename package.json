{
  "name": "learning-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm --filter web typecheck",
    "check:watch": "pnpm --filter web check:watch",
    "test": "pnpm --filter web test",
    "check": "pnpm --filter web check",
    "verify": "pnpm --filter web verify",
    "lint": "ultracite check --disable-nested-config && pnpm --filter web lint && pnpm --filter pack-cli lint",
    "lint:fix": "ultracite fix --disable-nested-config && pnpm --filter web lint:fix && pnpm --filter pack-cli lint:fix",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "validate": "pnpm lint",
    "verify:all": "pnpm fmt && pnpm --filter web verify && pnpm --filter pack-cli verify && ultracite check --disable-nested-config",
    "pack:build": "tsx apps/pack-cli/src/index.ts build",
    "pack:verify": "tsx apps/pack-cli/src/index.ts verify"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.15",
    "ultracite": "8.0.0"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
