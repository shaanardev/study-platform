{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "vite dev --host 127.0.0.1",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm typecheck && pnpm typecheck:scripts && pnpm validate && pnpm test",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:scripts": "tsc --project src/scripts/tsconfig.json",
    "validate": "biome check .",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:fix": "biome check --write ./src",
    "test:unit": "vitest run",
    "test": "vitest run",
    "pack:build": "node src/scripts/exam-packs/build.ts",
    "pack:verify": "node src/scripts/exam-packs/verify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-auto": "^8.0.0-next.0",
    "@sveltejs/kit": "^3.0.0-next.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
