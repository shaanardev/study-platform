{
  "name": "learning-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "db:up": "tsx app/web/scripts/db-up.ts",
    "build": "pnpm --filter web build",
    "e2e": "pnpm --filter web exec playwright test --config playwright.config.ts",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm --filter web typecheck && pnpm --dir app/pack-cli typecheck",
    "check:watch": "pnpm --filter web check:watch",
    "test": "vitest run",
    "coverage:check": "vitest run --coverage --coverage.reporter=text-summary",
    "verify": "pnpm lint:fix && pnpm lint && pnpm coverage:check",
    "plannotator": "PLANNOTATOR_DATA_DIR=$PWD/.plannotator plannotator",
    "lint": "ultracite check && pnpm --dir app/pack-cli lint && pnpm --filter web lint",
    "lint:fix": "ultracite fix && pnpm --dir app/pack-cli lint:fix && pnpm --filter web lint:fix",
    "pack:build": "tsx app/pack-cli/src/index.ts build",
    "pack:verify": "tsx app/pack-cli/src/index.ts verify",
    "pack:schema:generate": "pnpm --dir app/pack-cli packs schema generate",
    "pack:schema:check": "pnpm --dir app/pack-cli packs schema check",
    "wt:remove": "bash scripts/wt-remove-keep-branch.sh",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.59.0",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "8.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
