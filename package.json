{
  "name": "learning-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm --filter web typecheck",
    "check:watch": "pnpm --filter web check:watch",
    "test": "pnpm --filter web test",
    "check": "pnpm --filter web check",
    "verify": "ultracite fix apps/web && pnpm --filter web verify",
    "lint": "ultracite check && pnpm --filter web lint",
    "lint:fix": "ultracite fix && pnpm --filter web lint:fix",
    "validate": "pnpm lint",
    "verify:all": "pnpm lint:fix && pnpm --filter web check && pnpm --dir apps/pack-cli typecheck && pnpm --dir apps/pack-cli test",
    "pack:build": "tsx apps/pack-cli/src/index.ts build",
    "pack:verify": "tsx apps/pack-cli/src/index.ts verify"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@types/node": "^26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "8.0.0"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
