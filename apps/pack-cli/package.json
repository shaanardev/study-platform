{
  "name": "pack-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Local command-line tools for authoring and validating learning packs.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "packs": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "test": "vitest run",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "verify": "pnpm lint:fix && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@types/node": "^26.6.5",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "8.0.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.6.0"
}
