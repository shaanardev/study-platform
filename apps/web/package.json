{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "vite dev --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "pnpm typecheck && pnpm validate && pnpm test",
    "verify": "pnpm lint:fix && pnpm check",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "ultracite check",
    "validate": "pnpm lint",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:fix": "ultracite fix",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "caniuse-lite": "^1.0.30001815",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-html": "8.2.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-svelte": "3.23.1",
    "eslint-plugin-unicorn": "77.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1",
    "ultracite": "8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
