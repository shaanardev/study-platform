{
  "name": "pack-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Local command-line tools for authoring and validating learning packs.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "packs": "tsx src/index.ts",
