  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "@learning-platform/exam-pack": "workspace:*",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.59.0",
    "@types/node": "^26.6.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "8.1.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
