{
  "extends": ["$app/tsconfig", "../../tsconfig.base.json"],
  "compilerOptions": {
    "types": ["$app/types", "node"],

    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "exclude": ["node_modules", "pnpm-store", ".svelte-kit", "build", "dist", "coverage", "static"],
  "include": [
    "src",
    "eslint.config.ts",
    "prettier.config.ts",
    "vite.config.ts",
    "tests",
    "playwright.config.ts"
  ]
}
