{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    /* Project layout */
    "rootDir": "..",
    "outDir": "./dist",

    /* Runtime and module system */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["node"],

    /* Emit */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": false,

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,

    /* Code quality */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    /* Modern TypeScript behavior */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "useDefineForClassFields": true,

    /* Common Node project features */
    "resolveJsonModule": true,

    /* Faster and cleaner dependency checking */
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "oxlint.config.ts"],
  "exclude": ["node_modules", "dist", "coverage", "**/*.test-d.ts"],
  "plugins": [
    {
      "name": "@effect/language-service",
      "diagnostics": false,
      "diagnosticSeverity": {
        "abortControllerInEffect": "warning",
        "asyncFunction": "warning",
        "cryptoRandomUUID": "warning",
        "cryptoRandomUUIDInEffect": "warning",
        "extendsNativeError": "warning",
        "globalConsole": "warning",
        "globalConsoleInEffect": "warning",
        "globalDate": "warning",
        "globalDateInEffect": "warning",
        "globalFetch": "warning",
        "globalFetchInEffect": "warning",
        "globalRandom": "warning",
        "globalRandomInEffect": "warning",
        "globalTimers": "warning",
        "globalTimersInEffect": "warning",
        "instanceOfSchema": "warning",
        "newPromise": "warning",
        "nodeBuiltinImport": "warning",
        "preferSchemaOverJson": "warning",
        "processEnv": "warning",
        "processEnvInEffect": "warning"
      }
    }
  ]
}
