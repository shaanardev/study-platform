{
  "name": "pack-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "Local command-line tools for authoring and validating learning packs.",
  "private": true,
  "scripts": {
    "packs": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && biome check src test --error-on-warnings",
    "lint:fix": "oxlint --fix && biome check --write src test --error-on-warnings --unsafe",
    "test": "vitest run",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "verify": "pnpm lint:fix && pnpm typecheck && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.118",
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@effect/tsgo": "0.44.0",
    "@types/node": "^26.6.2",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
