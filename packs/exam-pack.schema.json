{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-platform.local/schemas/exam-pack.schema.json",
  "title": "Exam blueprint and question pack",
  "description": "Offline exam and question data with source paths relative to the pack file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exam", "pack", "domains", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "synthetic"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" },
        "synthetic": { "type": "boolean" }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "weight"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/text" },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
        }
      }
    },
    "passingThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "domainId",
          "prompt",
          "options",
          "answerIds",
          "explanation",
          "sources"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["single_choice", "multiple_choice"] },
          "domainId": { "$ref": "#/$defs/id" },
          "prompt": { "$ref": "#/$defs/text" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "text": { "$ref": "#/$defs/text" }
              }
            }
          },
          "answerIds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "explanation": { "$ref": "#/$defs/text" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "label"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "label": { "$ref": "#/$defs/text" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    }
  }
}
