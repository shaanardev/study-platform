{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "title",
          "weight"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "exam": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "title",
        "version"
      ],
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "synthetic": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "synthetic",
        "title",
        "version"
      ],
      "additionalProperties": false
    },
    "passingThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            "minItems": 1
          },
          "domainId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "documentationUrls": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:file:\\/\\/\\/[^?#\\\\]+|(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!\\/)(?!.*\\/\\/)(?!.*(?:^|\\/)(?:\\.|\\.\\.)(?:\\/|$))(?!.*[\\\\?#])[^?#]+)$"
                },
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "label",
                "path"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "single_choice",
              "multiple_choice"
            ]
          }
        },
        "required": [
          "answerIds",
          "domainId",
          "explanation",
          "id",
          "options",
          "prompt",
          "sources",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "schemaVersion": {
      "type": "number",
      "enum": [
        1
      ]
    }
  },
  "required": [
    "domains",
    "exam",
    "pack",
    "questions",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "$id": "https://learning-platform.local/schemas/exam-pack.schema.json",
  "description": "Exam and question data with bundled citations and absolute local file citations.",
  "title": "Exam blueprint and question pack"
}
